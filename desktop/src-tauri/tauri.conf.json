{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenShare",
  "version": "0.1.0",
  "identifier": "com.ocsscreen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScreenShare",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ScreenShare",
    "copyright": "ScreenShare",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"]
      }
    }
  }
}
