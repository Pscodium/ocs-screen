# Copie para .env (lido automaticamente via process.loadEnvFile() em server.ts).
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
VIEWER_URL=http://localhost:5173
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret1234567890
ROOM_TOKEN_TTL_SECONDS=21600
ROOM_EMPTY_TTL_SECONDS=300

# Redis compartilhado (o de produção, mesmo em dev). Sem isso o bot do Discord fica desligado.
# REDIS_URL=redis://:senha@host:6379
# Bot do Discord (Developer Portal → General Information / Bot). Interactions Endpoint URL:
# https://<backend>/discord/interactions
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# Só "true" em produção — dev usa o mesmo Redis e mandaria DM de verdade pra todos os inscritos.
# DISCORD_NOTIFY_ENABLED=false
