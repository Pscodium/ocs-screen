# Copie para .env (lido automaticamente via process.loadEnvFile() em server.ts).
PORT=4000
# Proxies reversos na frente do backend (IP real do cliente via X-Forwarded-For). 0 = sem proxy.
TRUST_PROXY_HOPS=1
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
VIEWER_URL=http://localhost:5173
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret1234567890
ROOM_TOKEN_TTL_SECONDS=21600
ROOM_EMPTY_TTL_SECONDS=300
# Versão mínima do app desktop aceita (X.Y.Z). Abaixo disso o app mostra "atualização obrigatória"
# e o backend recusa criar sala (426). Vazio = nenhuma versão bloqueada. Só subir depois que a
# versão nova já estiver aprovada na Microsoft Store (senão quem usa a Store fica sem saída).
# MIN_APP_VERSION=

# Redis compartilhado (o de produção, mesmo em dev). Sem isso o bot do Discord fica desligado.
# REDIS_URL=redis://:senha@host:6379
# Salas no Redis pra sobreviverem a restart/deploy (TTL de 3 min, renovado só enquanto a sala vive).
# Padrão: ligado só em produção (dev local usa o mesmo Redis de produção). Recomendado no Redis:
# maxmemory-policy volatile-lru, pra memória cheia descartar só salas e nunca os inscritos do Discord.
# ROOM_PERSISTENCE=true
# Bot do Discord (Developer Portal → General Information / Bot). Interactions Endpoint URL:
# https://<backend>/discord/interactions
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# Só "true" em produção — dev usa o mesmo Redis e mandaria DM de verdade pra todos os inscritos.
# DISCORD_NOTIFY_ENABLED=false

# Postgres — histórico de telemetria (/admin/stats). Sem isso, telemetria fica só no log.
# Dev local: `docker compose up -d postgres` → postgres://ocs:ocs@localhost:5432/ocs
# POSTGRES_URL=postgres://usuario:senha@host:5432/banco
# Token das rotas /admin/* (mín. 24 chars, `openssl rand -hex 32`). Sem ele, /admin responde 404.
# ADMIN_TOKEN=
# Dias que os eventos de telemetria ficam guardados (padrão 90).
# TELEMETRY_RETENTION_DAYS=90
# Pasta dos minidumps de crash do app desktop (produção: volume persistente).
# CRASH_DIR=./data/crashes
