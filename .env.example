# Backend
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Origem pública do viewer web — usada para montar o link completo da sala (sem barra no final)
VIEWER_URL=http://localhost:5173
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret1234567890
ROOM_TOKEN_TTL_SECONDS=21600
ROOM_EMPTY_TTL_SECONDS=300

# TURN (infra/docker-compose.yml, serviço coturn) — sem TURN_SECRET, o backend só oferece STUN
# público (funciona pra maioria das redes, mas não atravessa NAT simétrico/firewall restritivo).
# Gere um segredo de verdade em produção (ex.: `openssl rand -hex 32`) — NUNCA reaproveite o
# valor de exemplo abaixo.
TURN_SECRET=changeme-generate-a-real-secret
TURN_REALM=ocs-screen
# Host(s) que os CLIENTES usam pra alcançar o coturn (IP público/domínio, não o hostname interno
# do container) — múltiplos separados por vírgula.
TURN_URLS=turn:localhost:3478
TURN_CREDENTIAL_TTL_SECONDS=3600
# Só necessário se o host de PRODUÇÃO estiver atrás de NAT de nuvem sem IP público direto na
# interface (comum em VPS/cloud com IP elástico separado do IP da máquina) — formato
# "<publico>/<privado>" (ex.: "203.0.113.10/10.0.0.5"). Sem NAT na frente, deixa vazio/comentado —
# coturn detecta o IP sozinho (docker-compose.yml só adiciona --external-ip se isso vier setado).
# TURN_EXTERNAL_IP=

# Desktop / Viewer (Vite)
VITE_BACKEND_URL=http://localhost:4000
